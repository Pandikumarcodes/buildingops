# Copy to .env for local infrastructure and backend configuration.
POSTGRES_DB=buildingops
POSTGRES_USER=buildingops
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql+psycopg://buildingops:local_dev_only_change_me@localhost:5432/buildingops

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE_SECONDS=60
MQTT_QOS=1
MQTT_USERNAME=
MQTT_PASSWORD=

BACKEND_URL=http://127.0.0.1:8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Optional Gemini assistant configuration. Keep the key only in this root .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
